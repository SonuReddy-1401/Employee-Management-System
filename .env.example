# Auth Service Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
ADMIN_EMAIL=admin@ems.local
ADMIN_PASSWORD=admin_password_change_me

# Employee Service Configuration
EMPLOYEE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/employee_db

# Common Client & Resiliency Configuration
HTTP_CLIENT_TIMEOUT_SECONDS=5.0
HTTP_CLIENT_RETRY_COUNT=3
HTTP_CLIENT_BACKOFF_FACTOR=0.5
HTTP_CLIENT_BREAKER_FAIL_THRESHOLD=5
HTTP_CLIENT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# RabbitMQ & Event Outbox
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=ems.events

# Idempotent Consumer Configuration
CONSUMER_QUEUE_NAME=ems.queue
CONSUMER_DLQ_NAME=ems.dlq
CONSUMER_MAX_ATTEMPTS=3
