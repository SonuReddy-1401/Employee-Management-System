# Shared Security & Messaging
JWT_SECRET=default_jwt_secret_change_me_in_prod
JWT_ALGORITHM=HS256
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
OUTBOX_PUBLISHER_ENABLED=true
CONSUMER_ENABLED=true

# Auth Service
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_NAME=auth_db
AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:auth_pass@auth-db:5432/auth_db
ADMIN_EMAIL=admin@ems.com
ADMIN_PASSWORD=AdminPassword123!

# Employee Service
EMPLOYEE_DB_USER=emp_user
EMPLOYEE_DB_PASSWORD=emp_pass
EMPLOYEE_DB_NAME=employee_db
EMPLOYEE_DATABASE_URL=postgresql+asyncpg://emp_user:emp_pass@employee-db:5432/employee_db
EMPLOYEE_AUTH_SERVICE_URL=http://auth:8001
EMPLOYEE_PAYROLL_SERVICE_URL=http://payroll:8004

# Leave Service
LEAVE_DB_USER=leave_user
LEAVE_DB_PASSWORD=leave_pass
LEAVE_DB_NAME=leave_db
LEAVE_DATABASE_URL=postgresql+asyncpg://leave_user:leave_pass@leave-db:5432/leave_db
LEAVE_EMPLOYEE_SERVICE_URL=http://employee:8002
ANNUAL_PAID_LEAVE_DAYS=20

# Payroll Service
PAYROLL_DB_USER=payroll_user
PAYROLL_DB_PASSWORD=payroll_pass
PAYROLL_DB_NAME=payroll_db
PAYROLL_DATABASE_URL=postgresql+asyncpg://payroll_user:payroll_pass@payroll-db:5432/payroll_db

# Notification Service
NOTIFICATION_DB_USER=notif_user
NOTIFICATION_DB_PASSWORD=notif_pass
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://notif_user:notif_pass@notification-db:5432/notification_db

# Gateway Service
GATEWAY_AUTH_SERVICE_URL=http://auth:8001
GATEWAY_EMPLOYEE_SERVICE_URL=http://employee:8002
GATEWAY_LEAVE_SERVICE_URL=http://leave:8003
GATEWAY_PAYROLL_SERVICE_URL=http://payroll:8004
GATEWAY_NOTIFICATION_SERVICE_URL=http://notification:8005
UPSTREAM_TIMEOUT_SECONDS=10.0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10

# Grafana Administration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
