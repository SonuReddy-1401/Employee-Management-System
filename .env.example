# Auth Service Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
ADMIN_EMAIL=admin@ems.local
ADMIN_PASSWORD=admin_password_change_me

# Employee Service Configuration
EMPLOYEE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/employee_db
AUTH_SERVICE_URL=http://localhost:8001
PAYROLL_SERVICE_URL=http://localhost:8004
OUTBOX_PUBLISHER_ENABLED=true

# Leave Service Configuration
LEAVE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leave_db
REDIS_URL=redis://localhost:6379/0
EMPLOYEE_SERVICE_URL=http://localhost:8002
EMPLOYEE_CACHE_TTL_SECONDS=60
ANNUAL_PAID_LEAVE_DAYS=20

# Payroll Service Configuration
PAYROLL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payroll_db
PAYROLL_QUEUE_NAME=ems.payroll.queue
PAYROLL_DLQ_NAME=ems.payroll.dlq
PAYROLL_DLX_NAME=ems.payroll.dlx

# Notification Service Configuration
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_db
NOTIFICATION_QUEUE_NAME=ems.notification.queue
NOTIFICATION_DLQ_NAME=ems.notification.dlq
NOTIFICATION_DLX_NAME=ems.notification.dlx

# Common Client & Resiliency Configuration
HTTP_CLIENT_TIMEOUT_SECONDS=5.0
HTTP_CLIENT_RETRY_COUNT=3
HTTP_CLIENT_BACKOFF_FACTOR=0.5
HTTP_CLIENT_BREAKER_FAIL_THRESHOLD=5
HTTP_CLIENT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# RabbitMQ & Event Outbox
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=ems.events
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# Idempotent Consumer Configuration
CONSUMER_ENABLED=true
CONSUMER_QUEUE_NAME=ems.queue
CONSUMER_DLQ_NAME=ems.dlq
CONSUMER_MAX_ATTEMPTS=3
